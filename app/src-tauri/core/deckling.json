{
  "id": "core",
  "type": "core",
  "name": "Deck",
  "description": "What is fixed in the app: keys, pages, profiles, the primitive interfaces, the clock signals and the MQTT connection. Its settings are the deck's global settings.",
  "version": "1.0.0",
  "runtime": {
    "kind": "builtin"
  },
  "config": [
    {
      "key": "long_press_ms",
      "label": "Long press (ms)",
      "type": "number",
      "default": 500
    },
    {
      "key": "follow_active_app",
      "label": "Profiles follow the front app",
      "type": "toggle",
      "default": true
    },
    {
      "key": "brightness",
      "label": "Brightness",
      "type": "number",
      "default": 180
    },
    {
      "key": "screensaver.enabled",
      "label": "Screensaver",
      "type": "toggle",
      "default": true
    },
    {
      "key": "screensaver.idle_minutes",
      "label": "Screensaver after (min)",
      "type": "number",
      "default": 3
    },
    {
      "key": "mqtt.enabled",
      "label": "Connect",
      "type": "toggle",
      "default": false
    },
    {
      "key": "mqtt.host",
      "label": "Host",
      "type": "text",
      "default": "homeassistant.local"
    },
    {
      "key": "mqtt.port",
      "label": "Port",
      "type": "number",
      "default": 1883
    },
    {
      "key": "mqtt.username",
      "label": "User",
      "type": "text"
    },
    {
      "key": "mqtt.password",
      "label": "Password",
      "type": "text",
      "secret": true
    },
    {
      "key": "mqtt.base_topic",
      "label": "Base topic",
      "type": "text",
      "default": "d200"
    },
    {
      "key": "mqtt.discovery",
      "label": "Discovery",
      "type": "toggle",
      "default": true
    }
  ],
  "contributes": {
    "signals": "signals.json",
    "actions": "actions.json",
    "interfaces": "interfaces.json",
    "apps": "apps/"
  }
}
