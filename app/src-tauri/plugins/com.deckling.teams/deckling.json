{
  "id": "com.deckling.teams",
  "type": "plugin",
  "name": "Microsoft Teams",
  "version": "1.0.0",
  "description": "Meeting controls over the Teams local API, presence through Microsoft 365.",
  "runtime": {
    "kind": "builtin"
  },
  "config": [
    {
      "key": "port",
      "label": "Teams API port",
      "type": "number",
      "default": 8124,
      "group": "Meeting controls"
    },
    {
      "key": "client_id",
      "label": "Entra app (client) id",
      "type": "text",
      "placeholder": "00000000-0000-0000-0000-000000000000",
      "group": "Microsoft 365"
    },
    {
      "key": "tenant",
      "label": "Tenant",
      "type": "text",
      "default": "organizations",
      "placeholder": "yourcompany.com",
      "group": "Microsoft 365"
    },
    {
      "key": "away",
      "label": "Unavailable means",
      "type": "select",
      "default": "DoNotDisturb",
      "values": [
        {
          "label": "Do not disturb",
          "value": "DoNotDisturb"
        },
        {
          "label": "Busy",
          "value": "Busy"
        },
        {
          "label": "Away",
          "value": "Away"
        },
        {
          "label": "Be right back",
          "value": "BeRightBack"
        },
        {
          "label": "Appear offline",
          "value": "Offline"
        }
      ],
      "group": "Microsoft 365"
    }
  ],
  "contributes": {
    "signals": "signals.json",
    "actions": "actions.json",
    "apps": "apps/"
  }
}
