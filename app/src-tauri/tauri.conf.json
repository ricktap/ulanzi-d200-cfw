{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D200 Deck",
  "version": "0.13.0",
  "identifier": "dev.d200fw.deck",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "D200 Deck",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMEExN0YxM0UwRDMzOTcKUldTWE13MCs4UmNLclNzWFNGZXFZdDQyK25GelB5MDR3N0N4MCtJYUVsU0JZcFhtdW56eGNQTTYK",
      "endpoints": [
        "https://github.com/ricktap/ulanzi-d200-cfw/releases/latest/download/latest.json"
      ]
    }
  }
}
