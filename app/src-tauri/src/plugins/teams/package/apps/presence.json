{
  "id": "com.deckling.teams:presence",
  "name": "Teams presence",
  "description": "Your live Teams status. Press toggles available and unavailable, long press goes back to automatic. Needs a sign-in (Settings, Teams).",
  "icon": "com.deckling.core:presence-available",
  "face": "teams_presence",
  "implements": {
    "label": {
      "text": {
        "bind": "com.deckling.teams:presence",
        "fallback": ""
      }
    }
  },
  "on": {
    "press": [],
    "long": []
  },
  "states": [
    {
      "key": "available",
      "label": "Available",
      "icon": "com.deckling.core:presence-available"
    },
    {
      "key": "away",
      "label": "Away",
      "icon": "com.deckling.core:presence-away"
    },
    {
      "key": "busy",
      "label": "Busy, do not disturb",
      "icon": "com.deckling.core:do-not-disturb"
    },
    {
      "key": "offline",
      "label": "Offline, signed out",
      "icon": "com.deckling.core:teams"
    }
  ]
}
