{
  "id": "com.deckling.teams:camera",
  "name": "Teams camera",
  "description": "Live camera state in Teams meetings. Press turns it on or off.",
  "icon": "com.deckling.core:camera-on",
  "face": "teams_camera",
  "implements": {
    "toggle": {
      "on": {
        "bind": "com.deckling.teams:video",
        "fallback": false
      }
    }
  },
  "on": {
    "press": [],
    "long": []
  },
  "states": [
    {
      "key": "on",
      "label": "Camera on",
      "icon": "com.deckling.core:camera-on"
    },
    {
      "key": "off",
      "label": "Camera off",
      "icon": "com.deckling.core:camera-off"
    }
  ]
}
