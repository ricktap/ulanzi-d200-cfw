{
  "version": 2,
  "settings": {
    "brightness": 180,
    "long_press_ms": 500,
    "follow_active_app": true,
    "weather": {
      "location": null,
      "fahrenheit": false
    },
    "pomodoro": {
      "work": 25,
      "short_break": 5,
      "long_break": 15,
      "rounds": 4,
      "sound": true
    },
    "mqtt": {
      "enabled": false,
      "host": "homeassistant.local",
      "port": 1883,
      "username": "",
      "password": "",
      "tls": false,
      "base_topic": "d200",
      "discovery": true
    },
    "teams": {
      "port": 8124,
      "client_id": "",
      "tenant": "organizations",
      "away": "DoNotDisturb"
    },
    "screensaver": {
      "enabled": true,
      "idle_minutes": 3,
      "scene": "auto",
      "southern": false,
      "motion": true,
      "fps": 8
    },
    "cards": {
      "email": true,
      "meetings": true,
      "steam": true,
      "printer": true,
      "hide_content": false
    }
  },
  "status_key": {
    "app": "profile",
    "show": "auto",
    "on": {
      "press": [
        {
          "action": "core:home"
        }
      ],
      "long": [
        {
          "action": "core:remote"
        }
      ]
    }
  },
  "profiles": [
    {
      "name": "Default",
      "apps": [],
      "pages": {
        "main": {
          "0": {
            "app": "core:sysmon"
          },
          "1": {
            "app": "core:mute"
          },
          "2": {
            "app": "core:weather"
          },
          "3": {
            "app": "core:clock"
          },
          "4": {
            "app": "core:pomodoro"
          },
          "5": {
            "states": [
              {
                "label": "Terminal",
                "icon": "core:terminal-app",
                "on": {
                  "press": [
                    {
                      "action": "core:open",
                      "params": {
                        "target": "Terminal"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "states": [
              {
                "label": "Safari",
                "icon": "core:browser",
                "on": {
                  "press": [
                    {
                      "action": "core:open",
                      "params": {
                        "target": "Safari"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "7": {
            "states": [
              {
                "label": "Capture",
                "icon": "core:screenshot-region",
                "on": {
                  "press": [
                    {
                      "action": "core:keys",
                      "params": {
                        "combo": "cmd+shift+4"
                      }
                    }
                  ],
                  "long": [
                    {
                      "action": "core:keys",
                      "params": {
                        "combo": "cmd+shift+5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "8": {
            "app": "core:teams_mute"
          },
          "9": {
            "app": "core:media"
          },
          "10": {
            "states": [
              {
                "label": "Vol -",
                "icon": "core:volume-down",
                "on": {
                  "down": [
                    {
                      "action": "core:volume",
                      "params": {
                        "value": "-5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "11": {
            "states": [
              {
                "label": "Vol +",
                "icon": "core:volume-up",
                "on": {
                  "down": [
                    {
                      "action": "core:volume",
                      "params": {
                        "value": "+5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "12": {
            "states": [
              {
                "label": "Home",
                "icon": "core:home",
                "on": {
                  "press": [
                    {
                      "action": "core:remote"
                    }
                  ],
                  "long": [
                    {
                      "action": "core:page",
                      "params": {
                        "page": "more"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        "more": {
          "0": {
            "states": [
              {
                "label": "Back",
                "icon": "core:arrow-left",
                "on": {
                  "press": [
                    {
                      "action": "core:back"
                    }
                  ]
                }
              }
            ]
          },
          "1": {
            "states": [
              {
                "label": "Dark",
                "icon": "core:weather-moon",
                "on": {
                  "press": [
                    {
                      "action": "core:command",
                      "params": {
                        "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to true'"
                      }
                    },
                    {
                      "action": "core:state",
                      "params": {
                        "to": "next"
                      }
                    }
                  ]
                }
              },
              {
                "label": "Light",
                "icon": "core:weather-sun",
                "on": {
                  "press": [
                    {
                      "action": "core:command",
                      "params": {
                        "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to false'"
                      }
                    },
                    {
                      "action": "core:state",
                      "params": {
                        "to": "next"
                      }
                    }
                  ]
                },
                "fg": "#FFBF69"
              }
            ]
          },
          "2": {
            "states": [
              {
                "label": "Lock",
                "icon": "core:lock-computer",
                "on": {
                  "press": [
                    {
                      "action": "core:command",
                      "params": {
                        "command": "pmset displaysleepnow"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "5": {
            "states": [
              {
                "label": "Previous",
                "icon": "core:previous-track",
                "on": {
                  "press": [
                    {
                      "action": "core:media",
                      "params": {
                        "command": "previous"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "app": "core:media"
          },
          "7": {
            "states": [
              {
                "label": "Next",
                "icon": "core:next-track",
                "on": {
                  "press": [
                    {
                      "action": "core:media",
                      "params": {
                        "command": "next"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
