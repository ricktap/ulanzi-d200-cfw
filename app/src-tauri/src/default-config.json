{
  "version": 5,
  "plugins": {
    "core": {
      "config": {
        "brightness": 180,
        "long_press_ms": 500,
        "follow_active_app": true,
        "theme": {
          "palette": {
            "active": "#69E0C1",
            "info": "#B79AF7",
            "attention": "#FFBF69",
            "error": "#FF8278",
            "background": "#11171D"
          },
          "widgets": {}
        },
        "cards": {
          "email": true,
          "meetings": true,
          "steam": true,
          "printer": true,
          "hide_content": false
        },
        "mqtt": {
          "enabled": false,
          "host": "homeassistant.local",
          "port": 1883,
          "username": "",
          "password": "",
          "tls": false,
          "base_topic": "d200",
          "discovery": true
        },
        "screensaver": {
          "enabled": true,
          "idle_minutes": 3,
          "scene": "auto",
          "southern": false,
          "motion": true,
          "fps": 8
        }
      }
    },
    "com.deckling.core": {
      "config": {
        "weather": {
          "location": null,
          "fahrenheit": false
        },
        "pomodoro": {
          "work": 25,
          "short_break": 5,
          "long_break": 15,
          "rounds": 4,
          "sound": true
        }
      }
    },
    "com.deckling.teams": {
      "config": {
        "port": 8124,
        "client_id": "",
        "tenant": "organizations",
        "away": "DoNotDisturb"
      }
    }
  },
  "status_key": {
    "on": {
      "press": [
        {
          "action": "core:home"
        }
      ],
      "long": [
        {
          "action": "com.deckling.ha:remote"
        }
      ]
    },
    "app": "profile",
    "show": "auto"
  },
  "profiles": [
    {
      "name": "Default",
      "apps": [],
      "pages": {
        "main": {
          "0": {
            "app": "com.deckling.core:sysmon"
          },
          "1": {
            "app": "com.deckling.core:mute"
          },
          "2": {
            "app": "com.deckling.core:weather"
          },
          "3": {
            "app": "com.deckling.core:clock"
          },
          "4": {
            "app": "com.deckling.core:pomodoro"
          },
          "5": {
            "states": [
              {
                "label": "Terminal",
                "icon": "com.deckling.core:terminal-app",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:open",
                      "params": {
                        "target": "Terminal"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "states": [
              {
                "label": "Safari",
                "icon": "com.deckling.core:browser",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:open",
                      "params": {
                        "target": "Safari"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "7": {
            "states": [
              {
                "label": "Capture",
                "icon": "com.deckling.core:screenshot-region",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+shift+4"
                      }
                    }
                  ],
                  "long": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+shift+5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "8": {
            "app": "com.deckling.teams:mute"
          },
          "9": {
            "app": "com.deckling.core:media"
          },
          "10": {
            "states": [
              {
                "label": "Vol -",
                "icon": "com.deckling.core:volume-down",
                "on": {
                  "down": [
                    {
                      "action": "com.deckling.core:volume",
                      "params": {
                        "value": "-5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "11": {
            "states": [
              {
                "label": "Vol +",
                "icon": "com.deckling.core:volume-up",
                "on": {
                  "down": [
                    {
                      "action": "com.deckling.core:volume",
                      "params": {
                        "value": "+5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "12": {
            "states": [
              {
                "label": "Home",
                "icon": "com.deckling.core:home",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.ha:remote"
                    }
                  ],
                  "long": [
                    {
                      "action": "core:page",
                      "params": {
                        "page": "more"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        "more": {
          "0": {
            "states": [
              {
                "label": "Back",
                "icon": "com.deckling.core:arrow-left",
                "on": {
                  "press": [
                    {
                      "action": "core:back"
                    }
                  ]
                }
              }
            ]
          },
          "1": {
            "states": [
              {
                "label": "Dark",
                "icon": "com.deckling.core:weather-moon",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:command",
                      "params": {
                        "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to true'"
                      }
                    },
                    {
                      "action": "core:state",
                      "params": {
                        "to": "next"
                      }
                    }
                  ]
                }
              },
              {
                "label": "Light",
                "icon": "com.deckling.core:weather-sun",
                "fg": "#FFBF69",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:command",
                      "params": {
                        "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to false'"
                      }
                    },
                    {
                      "action": "core:state",
                      "params": {
                        "to": "next"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "2": {
            "states": [
              {
                "label": "Lock",
                "icon": "com.deckling.core:lock-computer",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:command",
                      "params": {
                        "command": "pmset displaysleepnow"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "5": {
            "states": [
              {
                "label": "Previous",
                "icon": "com.deckling.core:previous-track",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:media",
                      "params": {
                        "command": "previous"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "app": "com.deckling.core:media"
          },
          "7": {
            "states": [
              {
                "label": "Next",
                "icon": "com.deckling.core:next-track",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:media",
                      "params": {
                        "command": "next"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "Browser",
      "apps": [
        "com.apple.Safari",
        "com.google.Chrome",
        "org.mozilla.firefox",
        "company.thebrowser.Browser"
      ],
      "pages": {
        "main": {
          "0": {
            "states": [
              {
                "label": "Back",
                "icon": "com.deckling.core:arrow-left",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+["
                      }
                    }
                  ]
                }
              }
            ]
          },
          "1": {
            "states": [
              {
                "label": "Forward",
                "icon": "com.deckling.core:arrow-right",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+]"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "2": {
            "states": [
              {
                "label": "Reload",
                "icon": "com.deckling.core:refresh",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+r"
                      }
                    }
                  ],
                  "long": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+shift+r"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "3": {
            "states": [
              {
                "label": "New tab",
                "icon": "com.deckling.core:capture",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+t"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "4": {
            "states": [
              {
                "label": "Close tab",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+w"
                      }
                    }
                  ],
                  "long": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+shift+t"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "5": {
            "app": "com.deckling.core:sysmon"
          },
          "6": {
            "app": "com.deckling.core:mute"
          },
          "7": {
            "app": "com.deckling.core:clock"
          }
        }
      }
    },
    {
      "name": "Media",
      "apps": [
        "com.spotify.client",
        "com.apple.Music"
      ],
      "pages": {
        "main": {
          "0": {
            "states": [
              {
                "label": "Previous",
                "icon": "com.deckling.core:previous-track",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:media",
                      "params": {
                        "command": "previous"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "1": {
            "app": "com.deckling.core:media"
          },
          "2": {
            "states": [
              {
                "label": "Next",
                "icon": "com.deckling.core:next-track",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:media",
                      "params": {
                        "command": "next"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "3": {
            "app": "com.deckling.core:mute"
          },
          "5": {
            "states": [
              {
                "label": "Vol -",
                "icon": "com.deckling.core:volume-down",
                "on": {
                  "down": [
                    {
                      "action": "com.deckling.core:volume",
                      "params": {
                        "value": "-5"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "states": [
              {
                "label": "Vol +",
                "icon": "com.deckling.core:volume-up",
                "on": {
                  "down": [
                    {
                      "action": "com.deckling.core:volume",
                      "params": {
                        "value": "+5"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "Teams",
      "apps": [
        "com.microsoft.teams2",
        "com.microsoft.teams"
      ],
      "pages": {
        "main": {
          "0": {
            "app": "com.deckling.teams:mute"
          },
          "1": {
            "app": "com.deckling.teams:camera"
          },
          "2": {
            "app": "com.deckling.teams:presence"
          },
          "3": {
            "states": [
              {
                "label": "Raise hand",
                "icon": "com.deckling.core:teams-meeting",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.teams:meeting",
                      "params": {
                        "command": "toggle-hand"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "4": {
            "states": [
              {
                "label": "Leave\n(hold)",
                "icon": "com.deckling.core:end-call",
                "on": {
                  "long": [
                    {
                      "action": "com.deckling.teams:meeting",
                      "params": {
                        "command": "leave-call"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "5": {
            "states": [
              {
                "label": "Blur",
                "icon": "com.deckling.core:mode-focus-on",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.teams:meeting",
                      "params": {
                        "command": "toggle-background-blur"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "states": [
              {
                "label": "Chat",
                "icon": "com.deckling.core:teams-chat",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.teams:meeting",
                      "params": {
                        "command": "toggle-ui-chat"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "7": {
            "app": "com.deckling.core:clock"
          }
        }
      }
    },
    {
      "name": "JetBrains",
      "apps": [
        "com.jetbrains.WebStorm",
        "com.jetbrains.intellij",
        "com.jetbrains.intellij.ce",
        "com.jetbrains.pycharm",
        "com.jetbrains.pycharm.ce",
        "com.jetbrains.goland",
        "com.jetbrains.PhpStorm",
        "com.jetbrains.rider",
        "com.jetbrains.CLion",
        "com.jetbrains.rustrover",
        "com.jetbrains.datagrip"
      ],
      "pages": {
        "main": {
          "0": {
            "app": "com.deckling.jetbrains:debugger"
          },
          "1": {
            "states": [
              {
                "label": "Run",
                "icon": "com.deckling.core:play",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "ctrl+r"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "2": {
            "states": [
              {
                "label": "Stop",
                "icon": "com.deckling.core:debug-stop",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+f2"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "3": {
            "states": [
              {
                "label": "Resume",
                "icon": "com.deckling.core:timer-start",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+alt+r"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "4": {
            "states": [
              {
                "label": "Breakpoint",
                "icon": "com.deckling.core:breakpoint",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+f8"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "5": {
            "states": [
              {
                "label": "Step over",
                "icon": "com.deckling.core:step-over",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "f8"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "6": {
            "states": [
              {
                "label": "Step into",
                "icon": "com.deckling.core:step-into",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "f7"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "7": {
            "states": [
              {
                "label": "Step out",
                "icon": "com.deckling.core:step-out",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "shift+f8"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "8": {
            "states": [
              {
                "label": "Evaluate",
                "icon": "com.deckling.core:calculator",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "alt+f8"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "9": {
            "states": [
              {
                "label": "Find action",
                "icon": "com.deckling.core:search",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+shift+a"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "10": {
            "states": [
              {
                "label": "Reformat",
                "icon": "com.deckling.core:code-editor",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+alt+l"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "11": {
            "states": [
              {
                "label": "Terminal",
                "icon": "com.deckling.core:terminal",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "alt+f12"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "12": {
            "states": [
              {
                "label": "Commit",
                "icon": "com.deckling.core:git-branch",
                "on": {
                  "press": [
                    {
                      "action": "com.deckling.core:keys",
                      "params": {
                        "combo": "cmd+k"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
