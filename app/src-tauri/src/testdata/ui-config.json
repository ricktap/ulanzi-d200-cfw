{
  "version": 2,
  "settings": {
    "brightness": 180,
    "long_press_ms": 500,
    "follow_active_app": true,
    "weather": {
      "location": {
        "name": "Berlin",
        "lat": 52.5,
        "lon": 13.4
      },
      "fahrenheit": false
    },
    "pomodoro": {
      "work": 25,
      "short_break": 5,
      "long_break": 15,
      "rounds": 4,
      "sound": true
    },
    "mqtt": {
      "enabled": true,
      "host": "192.168.1.5",
      "port": 1883,
      "username": "deck",
      "password": "",
      "tls": false,
      "base_topic": "d200",
      "discovery": true
    }
  },
  "status_key": {
    "on": {
      "press": [
        {
          "action": "core:home"
        }
      ],
      "long": [
        {
          "action": "core:remote"
        }
      ]
    }
  },
  "profiles": [
    {
      "name": "Default",
      "apps": [],
      "pages": {
        "main": {
          "0": {
            "app": "core:sysmon",
            "states": [
              {
                "bg": "#0f172a",
                "on": {
                  "press": [],
                  "long": [],
                  "down": [],
                  "up": []
                }
              }
            ]
          },
          "1": {
            "app": "core:mute"
          },
          "5": {
            "states": [
              {
                "label": "Terminal",
                "icon": "💻",
                "bg": "#1e3a8a",
                "on": {
                  "press": [
                    {
                      "action": "core:open",
                      "params": {
                        "target": "Terminal"
                      }
                    }
                  ],
                  "long": [
                    {
                      "action": "core:keys",
                      "params": {
                        "combo": "cmd+n"
                      }
                    }
                  ],
                  "down": [
                    {
                      "action": "core:mqtt",
                      "params": {
                        "topic": "home/x",
                        "payload": "ON",
                        "retain": true
                      }
                    }
                  ],
                  "up": [
                    {
                      "action": "core:notify",
                      "params": {
                        "text": "Hello",
                        "icon": "🔔"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "8": {
            "states": [
              {
                "label": "Dark",
                "icon": "🌙",
                "bg": "#1f2937",
                "on": {
                  "press": [
                    {
                      "action": "core:state",
                      "params": {
                        "to": "next"
                      }
                    }
                  ]
                }
              },
              {
                "label": "",
                "bg": "#ca8a04",
                "on": {
                  "press": [
                    {
                      "action": "core:state",
                      "params": {
                        "to": "1"
                      }
                    },
                    {
                      "action": "core:profile",
                      "params": {
                        "profile": "auto"
                      }
                    },
                    {
                      "action": "core:brightness",
                      "params": {
                        "value": "+25"
                      }
                    },
                    {
                      "action": "core:back"
                    },
                    {
                      "action": "core:remote"
                    },
                    {
                      "action": "core:page",
                      "params": {
                        "page": "main"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "Code",
      "apps": [
        "com.microsoft.VSCode"
      ],
      "pages": {
        "main": {}
      }
    }
  ]
}
