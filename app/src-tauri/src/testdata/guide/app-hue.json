{
  "id": "com.ricktap.hue:light",
  "name": "Hue Lampe",
  "icon": "com.ricktap.hue:bulb",
  "implements": {
    "com.ricktap.hue:rgb_light": {
      "on": { "bind": "com.ricktap.hue:lamp.power", "fallback": false },
      "color": { "bind": "com.ricktap.hue:lamp.color", "fallback": "#87909E" },
      "brightness": { "bind": "com.ricktap.hue:lamp.brightness", "fallback": 0 }
    },
    "rgb": {
      "color": { "bind": "com.ricktap.hue:lamp.color", "fallback": "#87909E" }
    },
    "toggle": {
      "on": { "bind": "com.ricktap.hue:lamp.power", "fallback": false }
    }
  },
  "on": {
    "press": [{ "action": "com.ricktap.hue:lamp.toggle" }]
  }
}
