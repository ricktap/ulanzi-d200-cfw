{
  "id": "core:clock",
  "name": "Uhr",
  "icon": "core:clock",
  "config": [
    {
      "key": "display",
      "label": "Anzeige",
      "type": "select",
      "default": "analog",
      "values": [
        { "label": "Analog", "value": "analog" },
        { "label": "Digital", "value": "digital" }
      ]
    }
  ],
  "implements": {
    "clock": {
      "time": { "bind": "time.clock", "fallback": "" },
      "hour_angle": { "bind": "time.hour_angle", "fallback": 0 },
      "minute_angle": { "bind": "time.minute_angle", "fallback": 0 },
      "style": { "config": "display" }
    }
  }
}
