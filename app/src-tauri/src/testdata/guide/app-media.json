{
  "id": "com.ricktap.media:player",
  "name": "Musik",
  "icon": "com.ricktap.media:disc",
  "implements": {
    "com.ricktap.media:player": {
      "playing": { "bind": "com.ricktap.media:playing", "fallback": false },
      "progress": { "bind": "com.ricktap.media:progress", "fallback": 0 },
      "title": { "bind": "com.ricktap.media:title", "fallback": "" },
      "color": { "bind": "com.ricktap.media:color", "fallback": "#87909E" }
    },
    "progress": {
      "value": { "bind": "com.ricktap.media:progress", "fallback": 0 }
    },
    "toggle": {
      "on": { "bind": "com.ricktap.media:playing", "fallback": false }
    }
  },
  "on": {
    "press": [{ "action": "com.ricktap.media:toggle" }],
    "long": [{ "action": "com.ricktap.media:next" }]
  }
}
